<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome Driver!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/createRideButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create New Ride"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/viewMyRidesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View My Rides"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3" />

    <Button
        android:id="@+id/viewRequestsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Ride Requests"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#FF9800" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textSize="16sp"
        android:backgroundTint="#F44336" />

</LinearLayout>